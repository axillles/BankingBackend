# Скопируйте в .env и заполните своими значениями. Файл .env в git не попадает.

# Ключ API https://twelvedata.com (бесплатный тариф подходит)
TWELVEDATA_API_KEY=

# Подключение к MySQL
DB_URL=jdbc:mysql://localhost:3306/banking
DB_USERNAME=user
DB_PASSWORD=

# Секрет для подписи JWT (HMAC256), любая длинная случайная строка, например: openssl rand -base64 48
JWT_SECRET=

# Автообновление курсов валют раз в 6 часов
EXCHANGE_RATES_SCHEDULER_ENABLED=true
